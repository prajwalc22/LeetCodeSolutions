#include <iostream>
#include <unordered_map>
#include <climits>

using namespace std;

int main() {

    string s;
    cin >> s;

    // Store the frequency of every character
    unordered_map<char, int> mp;

    for (char c : s) {
        mp[c]++;
    }

    // Start with the biggest possible integer
    // because we are looking for the minimum
    int ans = INT_MAX;

    // "balloon" needs:
    // b -> 1
    // a -> 1
    // l -> 2
    // o -> 2
    // n -> 1

    // Check how many balloons each character can contribute
    ans = min(ans, mp['b']);
    ans = min(ans, mp['a']);
    ans = min(ans, mp['l'] / 2);
    ans = min(ans, mp['o'] / 2);
    ans = min(ans, mp['n']);

    // Print the maximum number of balloons
    cout << ans << endl;

    return 0;
}
